  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.2"
    },
    "sucrase": {
      "glob": "^14.0.3"
    }
  }
}
