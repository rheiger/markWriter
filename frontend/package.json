{
  "name": "markwriter-frontend",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc && vite build",
    "build:acceptance": "tsc && vite build --mode acceptance --outDir dist-acceptance",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-markdown": "^6.2.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.5.5",
    "@codemirror/state": "^6.3.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.22.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-blockquote": "^3.32.3",
    "@tiptap/extension-bold": "^3.32.3",
    "@tiptap/extension-bullet-list": "^3.32.3",
    "@tiptap/extension-code": "^3.32.3",
    "@tiptap/extension-code-block": "3.32.3",
    "@tiptap/extension-code-block-lowlight": "^3.32.3",
    "@tiptap/extension-hard-break": "^3.32.3",
    "@tiptap/extension-heading": "^3.32.3",
    "@tiptap/extension-history": "^3.32.3",
    "@tiptap/extension-horizontal-rule": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-italic": "^3.32.3",
    "@tiptap/extension-link": "^3.32.3",
    "@tiptap/extension-list-item": "^3.32.3",
    "@tiptap/extension-ordered-list": "^3.32.3",
    "@tiptap/extension-placeholder": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-table-cell": "^3.32.3",
    "@tiptap/extension-table-header": "^3.32.3",
    "@tiptap/extension-table-row": "^3.32.3",
    "@tiptap/extension-task-item": "^3.32.3",
    "@tiptap/extension-task-list": "^3.32.3",
    "@tiptap/extension-text-align": "^3.32.3",
    "@tiptap/extension-underline": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@types/turndown": "^5.0.5",
    "@viz-js/viz": "3.31.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "highlight.js": "11.11.1",
    "katex": "0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.263.1",
    "markdown-it": "^15.0.3",
    "markdown-it-ins": "^3.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^9.1.6",
    "mermaid": "^12.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^4.4.0"
