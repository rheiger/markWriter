node_modules/
package-lock.json
.hintrc

# Rust / Tauri
src-tauri/Cargo.lock
src-tauri/target/
src-tauri/gen/

# Tauri icons (generated/compiled)
src-tauri/icons/*.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png
src-tauri/icons/128x128*.png
src-tauri/icons/32x32.png

# Keep only the source icon files
!src-tauri/icons/icon.png
!src-tauri/icons/README.md

